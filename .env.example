# .env.example - copy to .env and fill secrets (DO NOT commit .env)
# Application
SPRING_APPLICATION_NAME=MathExpAssistant
SPRING_PROFILES_ACTIVE=dev

# MongoDB (either set URI or individual parts)
# Example URI: mongodb://<user>:<pass>@host:27017/dbname?authSource=admin
MONGODB_URI=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=mathAssistant
MONGODB_USERNAME=admin
MONGODB_PASSWORD=admin123
MONGODB_AUTH_DB=admin

# JWT
JWT_SECRET=replace_with_jwt_secret
JWT_EXPIRATION=3600000

# OAuth (Google)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://localhost:8080/login/oauth2/code/google

# Notes:
# - Keep a local .env (gitignored) with real secrets for dev.
# - In production, use your cloud Secret Manager / Kubernetes Secrets and inject as env vars.
